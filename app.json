{
  "expo": {
    "name": "Phrases Notebook",
    "slug": "phrases-notebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/my-icon.png",
    "splash": {
      "image": "./assets/my-adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.net.w3software",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/my-adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "br.net.w3software",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
